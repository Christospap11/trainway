# Copy this file to .env and fill in values from your Supabase dashboard.
# .env is git-ignored; never commit real secrets.

# Supabase → Settings → Database → Connection string
#  • DATABASE_URL = "Transaction pooler" URI (port 6543), add ?pgbouncer=true
#  • DIRECT_URL   = "Direct connection" URI (port 5432) — used for migrations
DATABASE_URL=
DIRECT_URL=

# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
